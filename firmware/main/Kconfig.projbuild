menu "Kit firmware"

    choice KIT_APP
        prompt "Application"
        default KIT_APP_LOOPER
        help
            Which program the board runs. Both share the audio engine, voice
            tracker, OLED driver and self-test.

        config KIT_APP_LOOPER
            bool "Voice looper (drums, bass, chords, lead, vocal)"
        config KIT_APP_INSTRUMENT
            bool "Voice instrument (vocoder, autotune, guitar, delay, ...)"
    endchoice

    config KIT_LOOP_MAX_SEC
        int "Looper: longest loop in seconds"
        range 2 60
        default 12
        depends on KIT_APP_LOOPER
        help
            Sets the size of the vocal loop buffer (one byte per sample, so
            12 s at 16 kHz is 192 KB of RAM). Drum takes longer than this are
            rejected. If the allocation fails the size is halved until it fits.

    config KIT_MIC_GAIN
        int "Mic gain (linear multiplier)"
        range 1 64
        default 8
        help
            The INMP441 is fairly quiet. Samples are multiplied by this
            before anything else sees them.

    config KIT_GATE_DB
        int "Voice gate threshold (dBFS, after mic gain)"
        range -80 0
        default -42
        help
            The instrument only reacts while the mic is louder than this.
            The gate closes 8 dB below it, after a short hold.

    config KIT_BPM
        int "Tempo for the delay and stutter modes"
        range 40 240
        default 120

    config KIT_AMP_ALWAYS_ON
        bool "Keep the speaker amp on all the time"
        default n
        help
            By default the MAX98357A is only enabled while the encoder button
            is held, because mic -> speaker feedback howls. Enable this if you
            have no encoder wired yet or want to test the speaker freely.

    config KIT_USB_MIDI
        bool "USB MIDI device (TinyUSB, experimental)"
        default n
        help
            Make the board a USB MIDI device plus a CDC serial console using
            TinyUSB. This takes over the USB port, so the normal USB
            Serial/JTAG console and flashing path are gone; build with
            sdkconfig.defaults.usbmidi and flash with tools/flash.sh.

    config KIT_SAMPLE_RATE
        int "Sample rate (Hz)"
        default 32000
        help
            Shared by mic and both DACs. 32000 gives 16 kHz of bandwidth,
            which is what the hats and sibilants need; the S3 has the CPU
            for it. 16000 halves every buffer if RAM gets tight.

    config KIT_ONSET_DB
        int "Beatbox onset threshold above the noise floor (dB)"
        range 6 40
        default 20
        depends on KIT_APP_LOOPER
        help
            A hit must exceed the tracked background noise by this much,
            and jump by at least 8 dB, before it counts as a drum.

endmenu
